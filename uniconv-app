#!/bin/bash
# Startet die uniconv App (lokaler Server + App-Fenster).
set -uo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
PY="$DIR/.venv/bin/python"
WANT_VERSION="$(sed -n 's/^APP_VERSION = "\(.*\)"/\1/p' "$DIR/uniconv_app.py")"

# venv ggf. anlegen (macht das CLI-Startskript)
[ -x "$PY" ] || "$DIR/uniconv" --help >/dev/null 2>&1

find_server() {
    for PORT in $(seq 8756 8765); do
        RESP="$(curl -s --max-time 1 "http://127.0.0.1:$PORT/ping" 2>/dev/null)" || continue
        case "$RESP" in
            *'"app": "uniconv"'*)
                if [[ "$RESP" == *"\"version\": \"$WANT_VERSION\""* ]]; then
                    echo "$PORT"; return 0
                else
                    # alte Version läuft noch – beenden, damit die neue startet
                    curl -s -X POST "http://127.0.0.1:$PORT/shutdown" >/dev/null 2>&1
                fi
                ;;
        esac
    done
    return 1
}

PORT="$(find_server)" || {
    nohup "$PY" "$DIR/uniconv_app.py" >/dev/null 2>&1 &
    for _ in $(seq 1 40); do
        PORT="$(find_server)" && break
        sleep 0.25
    done
}

[ -n "${PORT:-}" ] || { echo "uniconv App konnte nicht gestartet werden."; exit 1; }

URL="http://127.0.0.1:$PORT"
if [ -d "/Applications/Google Chrome.app" ]; then
    open -na "Google Chrome" --args --app="$URL"
else
    open "$URL"
fi
